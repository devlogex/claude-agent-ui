{
  "name": "claude-agent-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Local web UI to browse, edit, schedule and run Claude Code agents as background sessions",
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "ui",
    "local"
  ],
  "license": "MIT",
  "bin": {
    "claude-agent-ui": "dist/cli.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
